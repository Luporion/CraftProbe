#!/bin/sh
# CraftProbe Gradle 8.14 bootstrap. Verifies the wrapper JAR before executing.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
export CRAFTPROBE_GRADLE_WRAPPER_ROOT="$APP_HOME"
python3 - <<'PY'
import hashlib, os, pathlib, tempfile, urllib.request, urllib.error
root = pathlib.Path(os.environ['CRAFTPROBE_GRADLE_WRAPPER_ROOT'])
jar = root / 'gradle/wrapper/gradle-wrapper.jar'
expected = '7d3a4ac4de1c32b59bc6a4eb8ecb8e612ccd0cf1ae1e99f66902da64df296172'
if jar.is_file():
    actual = hashlib.sha256(jar.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(f'Gradle Wrapper-JAR SHA256 mismatch: {actual}')
else:
    jar.parent.mkdir(parents=True, exist_ok=True)
    print('Downloading verified Gradle 8.14 wrapper (first use only)...', flush=True)
    fd, tmp = tempfile.mkstemp(prefix='.gradle-wrapper-', dir=str(jar.parent))
    try:
        source = 'https://raw.githubusercontent.com/gradle/gradle/v8.14.0/gradle/wrapper/gradle-wrapper.jar'
        try:
            with urllib.request.urlopen(source, timeout=30) as response, open(tmp, 'wb') as out:
                while True:
                    chunk = response.read(65536)
                    if not chunk: break
                    out.write(chunk)
        except (OSError, urllib.error.URLError) as exc:
            raise SystemExit(f'Gradle wrapper DOWNLOAD failed ({source}): {exc}') from exc
        actual = hashlib.sha256(pathlib.Path(tmp).read_bytes()).hexdigest()
        if actual != expected:
            raise SystemExit(f'Gradle wrapper SHA256 mismatch: expected {expected}, received {actual}. JAR will not run.')
        if jar.is_file():
            existing = hashlib.sha256(jar.read_bytes()).hexdigest()
            if existing != expected:
                raise SystemExit(f'Gradle wrapper SHA256 mismatch for concurrently created JAR: {existing}')
        else:
            try:
                os.replace(tmp, jar)
            except OSError as exc:
                raise SystemExit(f'Gradle wrapper FILESYSTEM failure: {exc}') from exc
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
PY
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi
exec "$JAVA" -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
